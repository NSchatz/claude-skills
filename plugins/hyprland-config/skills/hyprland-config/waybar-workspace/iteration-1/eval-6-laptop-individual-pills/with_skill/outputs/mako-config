# ── Mako notification daemon config ──────────────────────────────────
max-visible=5
sort=-time
layer=overlay
anchor=top-right

font=JetBrainsMono Nerd Font 11
background-color=#1a1b26ee
text-color=#c0caf5
border-color=#7aa2f7
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=5000
ignore-timeout=0

[urgency=low]
border-color=#565f89
default-timeout=3000

[urgency=high]
border-color=#f7768e
default-timeout=0
